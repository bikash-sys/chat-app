# Backend API URL
# For Android emulator: http://10.0.2.2:5001
# For physical device: http://<YOUR_COMPUTER_LOCAL_IP>:5001
# For Web: http://localhost:5001
EXPO_PUBLIC_API_URL=http://localhost:5001

# Firebase Web App Configuration (from Firebase Console -> Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
